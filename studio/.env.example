# Copier ce fichier en `.env` puis renseigner la valeur.
#
# URL du build hook Netlify (production). À créer dans Netlify :
#   Site settings → Build & deploy → Build hooks → Add build hook (branche : main)
# Le Studio l'utilise dans l'outil « Publier » pour redéclencher un build prod à la demande.
SANITY_STUDIO_NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/XXXXXXXXXXXXXXXX

# Port du serveur de dev du Studio (optionnel — défaut : 3334, cf. sanity.cli.ts).
# À changer uniquement si 3334 est déjà pris par un autre projet sur la machine.
SANITY_STUDIO_PORT=3334

# URL du site de production (optionnel — défaut : https://boracars.com). Le Dashboard y lit
# la date du build en ligne (/_nuxt/builds/latest.json) et y renvoie les liens « Voir le site ».
SANITY_STUDIO_SITE_URL=https://boracars.com

# URL du site de test (branche develop, optionnel — défaut : https://develop.boracars.com).
# Lien « Site de test » du Dashboard : montre le contenu publié sans attendre la mise en ligne.
SANITY_STUDIO_PREVIEW_SITE_URL=https://develop.boracars.com
